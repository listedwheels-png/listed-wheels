# ==========================================
# ListedWheels - Environment Variables
# ==========================================

# Application
APP_NAME=ListedWheels
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=listedwheels-super-secret-key-change-in-production-32bytes-min

# CORS (JSON Array of strings or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=listedwheels
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/listedwheels

# JWT & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AWS S3 & CloudFront (ap-south-1 Mumbai)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_PUBLIC_BUCKET=listedwheels-photos-dev
S3_PRIVATE_BUCKET=listedwheels-docs-dev
CLOUDFRONT_DOMAIN=https://photos-dev.listedwheels.com

# Monitoring & Error Tracking (Optional)
SENTRY_DSN=
